{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/majorminorlabs/vram-tier-map/blob/main/harness/schema/results.schema.json",
  "title": "VRAM Tier Map results.csv columns",
  "schema_version": "1.0",
  "format": "CSV",
  "columns": [
    {"name": "card_id", "type": "string", "required": true},
    {"name": "run_id", "type": "string", "required": true, "pattern": "YYYY-MM-DD_rNN"},
    {"name": "model_id", "type": "string", "required": true},
    {"name": "quant", "type": "string", "required": true},
    {"name": "task_pass", "type": "boolean", "required": true},
    {"name": "prompt_tps", "type": "number|null", "required": false, "minimum": 0},
    {"name": "generation_tps", "type": "number|null", "required": true, "minimum": 0},
    {"name": "ttft_ms", "type": "number|null", "required": true, "minimum": 0},
    {"name": "vram_peak_gb", "type": "number|null", "required": false, "minimum": 0},
    {"name": "cost_usd", "type": "number|null", "required": false, "minimum": 0},
    {"name": "flags", "type": "string", "required": true}
  ]
}
